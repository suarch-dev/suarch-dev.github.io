---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio, type Locale } from '../data/portfolio';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = portfolio[locale];
const alternate = portfolio[locale === 'en' ? 'es' : 'en'];
// Repeating one full set eight times keeps the marquee filled on wide desktop screens.
const tickerItems = Array.from({ length: 8 }, () => t.ticker).flat();

const progressLabels = {
  complete: t.route.completedLabel,
  current: t.route.currentLabel,
  next: t.route.nextLabel,
};
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang={locale}
  canonicalPath={t.homeHref}
  alternatePath={alternate.homeHref}
>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href={t.homeHref} aria-label="Arnold Chuctaya — home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M4 17h4l3-8 5 15 4-11 3 4h5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="brand-name">ARNOLD<span class="brand-divider">/</span>CHUCTAYA</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-label={locale === 'en' ? 'Toggle navigation' : 'Abrir navegación'}
        aria-expanded="false"
        aria-controls="site-navigation"
        data-menu-toggle
      >
        <span></span><span></span>
      </button>

      <nav id="site-navigation" class="site-nav" aria-label={locale === 'en' ? 'Main navigation' : 'Navegación principal'} data-menu>
        {t.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="language-switch" href={alternate.homeHref} lang={alternate.lang} aria-label={alternate.localeName}>
          {t.alternateLabel}<span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero section-wrap" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="hero-kicker">
            <span class="status-dot" aria-hidden="true"></span>
            <span>{t.hero.eyebrow}</span>
          </div>
          <p class="hero-location"><span class="tiny-cross" aria-hidden="true">+</span>{t.hero.location}</p>
          <h1 id="hero-title" class="hero-title">
            {t.hero.lines.map((line) => (
              <span class:list={['hero-title-line', line.accent && 'hero-title-accent']}>{line.text}{' '}</span>
            ))}
          </h1>
          <p class="hero-description">{t.hero.description}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">
              {t.hero.primaryCta}<span aria-hidden="true">↘</span>
            </a>
            <a class="button button-quiet" href={t.cvHref}>
              {t.hero.secondaryCta}<span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="hero-availability"><span aria-hidden="true">↳</span>{t.hero.availability}</p>

          <div class="hero-proof" aria-label={locale === 'en' ? 'Experience and study' : 'Experiencia y aprendizaje'}>
            <div class="proof-item">
              <span class="proof-value">{t.hero.metricYears}</span>
              <span class="proof-label">{t.hero.metricYearsLabel}</span>
            </div>
            <span class="proof-divider" aria-hidden="true"></span>
            <div class="proof-item">
              <span class="proof-value">{t.hero.metricProjects}</span>
              <span class="proof-label">{t.hero.metricProjectsLabel}</span>
            </div>
          </div>
        </div>

        <div class="hero-visual" aria-label={t.hero.portraitCaption}>
          <div class="portrait-stage">
            <figure class="portrait-card">
              <div class="portrait-photo-wrap">
                <img
                  class="portrait-photo"
                  src="/images/arnold-avatar.jpg"
                  alt={t.hero.portraitAlt}
                  width="460"
                  height="460"
                  fetchpriority="high"
                />
                <span class="portrait-initials" aria-hidden="true">AC</span>
              </div>
              <figcaption>
                <span class="portrait-caption-label">{t.hero.portraitCaption}</span>
                <span class="portrait-caption-name">ARNOLD CHUCTAYA</span>
              </figcaption>
            </figure>
            <svg class="signal-drawing" viewBox="0 0 440 190" fill="none" aria-hidden="true">
              <path class="signal-drawing-line" d="M4 100h24l11-30 15 62 18-96 19 111 17-71 17 42h23l18-30h20l18 18h29l18-18h27l15-28 16 42h29l17-17h42" />
              <circle class="signal-node" cx="49" cy="132" r="4" />
              <circle class="signal-node" cx="204" cy="138" r="4" />
              <circle class="signal-node" cx="365" cy="129" r="4" />
              <path class="signal-drawing-grid" d="M0 155h440M0 35h440M80 0v190M220 0v190M360 0v190" />
            </svg>
          </div>
          <div class="focus-note">
            <span>{t.hero.focusLabel}</span>
            <strong>{t.hero.focusValue}</strong>
          </div>
        </div>
      </section>

      <div class="ticker" role="img" aria-label={locale === 'en' ? 'VoIP, networks, support, Linux and Platform Engineering' : 'VoIP, redes, soporte, Linux e ingeniería de plataformas'}>
        <div class="ticker-track" aria-hidden="true">
          {tickerItems.map((item) => <span class="ticker-entry"><span>{item}</span><b>✳</b></span>)}
        </div>
      </div>

      <section id="profile" class="section section-wrap profile-section" aria-labelledby="profile-heading">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-index">{t.profile.eyebrow}</p>
            <h2 id="profile-heading">{t.profile.heading}</h2>
          </div>
          <p class="section-intro">{t.profile.body}</p>
        </div>

        <div class="strength-grid">
          {t.profile.strengths.map((strength, index) => (
            <article class="strength-card">
              <span class="strength-number">0{index + 1}</span>
              <span class="strength-rule" aria-hidden="true"></span>
              <h3>{strength.title}</h3>
              <p>{strength.body}</p>
            </article>
          ))}
        </div>

        <div class="belief-grid">
          <article class="belief-card belief-card-main">
            <p class="micro-label">{t.profile.directionLabel}</p>
            <h3>{t.profile.directionHeading}</h3>
            <p>{t.profile.directionBody}</p>
            <div class="belief-ornament" aria-hidden="true">
              <span>DIAGNOSE</span><i></i><span>AUTOMATE</span><i></i><span>IMPROVE</span>
            </div>
          </article>
          <article class="belief-card belief-card-ai">
            <p class="micro-label">{t.profile.aiLabel}</p>
            <span class="ai-glyph" aria-hidden="true">✳</span>
            <h3>{t.profile.aiHeading}</h3>
            <p>{t.profile.aiBody}</p>
          </article>
        </div>
      </section>

      <section id="experience" class="section section-wrap experience-section" aria-labelledby="experience-heading">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-index">{t.experience.eyebrow}</p>
            <h2 id="experience-heading">{t.experience.heading}</h2>
          </div>
          <p class="section-intro">{t.experience.intro}</p>
        </div>

        <div class="experience-list">
          {t.experience.roles.map((role, index) => (
            <article class="experience-entry">
              <div class="experience-marker">
                <span>0{index + 1}</span>
                <span class="experience-marker-dot" aria-hidden="true"></span>
              </div>
              <div class="experience-date">
                <time>{role.period}</time>
                <span>{role.duration}</span>
              </div>
              <div class="experience-content">
                <div class="experience-title-row">
                  <div>
                    <h3>{role.company}</h3>
                    <p>{role.role}</p>
                  </div>
                  <span class="experience-place">{role.place}</span>
                </div>
                <ul>
                  {role.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="work" class="section section-wrap work-section" aria-labelledby="work-heading">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-index">{t.work.eyebrow}</p>
            <h2 id="work-heading">{t.work.heading}</h2>
          </div>
          <p class="section-intro">{t.work.intro}</p>
        </div>

        <div class="project-grid">
          {t.work.projects.map((project) => (
            <article class:list={['project-card', `project-card-${project.accent}`]}>
              <div class="project-card-top">
                <span class="project-number">{project.number}</span>
                <span class="project-category">{project.category}</span>
                <span class="project-card-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="project-visual" aria-hidden="true">
                <div class="project-visual-grid"></div>
                <span class="project-mark">{project.mark}</span>
                {project.number === '01' ? (
                  <svg viewBox="0 0 600 90" fill="none">
                    <path d="M2 46h40l14-29 17 56 18-46 16 28h47l15-22 17 44 19-52 16 31h43l13-15 16 30 19-40 15 24h48l15-15 18 29 17-32 17 18h96" />
                    <circle cx="56" cy="17" r="4" /><circle cx="270" cy="29" r="4" /><circle cx="440" cy="50" r="4" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 600 90" fill="none">
                    <rect x="22" y="20" width="118" height="50" rx="2" />
                    <rect x="242" y="20" width="118" height="50" rx="2" />
                    <rect x="462" y="20" width="118" height="50" rx="2" />
                    <path d="M140 45h102M360 45h102" />
                    <path d="M226 38l16 7-16 7M446 38l16 7-16 7" />
                    <circle cx="41" cy="35" r="3" /><circle cx="261" cy="35" r="3" /><circle cx="481" cy="35" r="3" />
                  </svg>
                )}
              </div>
              <div class="project-card-body">
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class="tag-list" aria-label={locale === 'en' ? 'Technologies' : 'Tecnologías'}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <div class="project-links">
                  <a href={project.caseHref}>{t.work.caseLabel}<span aria-hidden="true">→</span></a>
                  <a href={project.repo} target="_blank" rel="noreferrer">{t.work.sourceLabel}<span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="more-work">
          <span class="more-work-mark" aria-hidden="true">+</span>
          <div><span class="micro-label">{t.work.noteLabel}</span><p>{t.work.noteText}</p></div>
          <a href={t.work.noteHref} target="_blank" rel="noreferrer">{t.work.noteLink}<span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="route" class="section section-wrap route-section" aria-labelledby="route-heading">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-index">{t.route.eyebrow}</p>
            <h2 id="route-heading">{t.route.heading}</h2>
          </div>
          <p class="section-intro">{t.route.intro}</p>
        </div>

        <div class="route-legend" aria-label={locale === 'en' ? 'Roadmap status legend' : 'Leyenda de estados'}>
          <span><i class="legend-dot legend-dot-complete"></i>{t.route.completedLabel}</span>
          <span><i class="legend-dot legend-dot-current"></i>{t.route.currentLabel}</span>
          <span><i class="legend-dot legend-dot-next"></i>{t.route.nextLabel}</span>
        </div>

        <ol class="route-list">
          {t.route.items.map((item) => (
            <li class:list={['route-item', `route-${item.status}`]}>
              <span class="route-step">{item.step}</span>
              <span class="route-node" aria-hidden="true"></span>
              <article class="route-card">
                <div class="route-card-heading">
                  <h3>{item.title}</h3>
                  <span class="route-status">{progressLabels[item.status]}</span>
                </div>
                <p>{item.body}</p>
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
                  {item.proof}<span aria-hidden="true">{item.href.startsWith('http') ? ' ↗' : ' →'}</span>
                </a>
              </article>
            </li>
          ))}
        </ol>
        <p class="route-footnote"><span aria-hidden="true">i</span>{t.route.footer}</p>
      </section>

      <section id="learning" class="section section-wrap learning-section" aria-labelledby="learning-heading">
        <div class="section-heading section-heading-split">
          <div>
            <p class="section-index">{t.learning.eyebrow}</p>
            <h2 id="learning-heading">{t.learning.heading}</h2>
          </div>
          <p class="section-intro">{t.learning.intro}</p>
        </div>

        <div class="learning-grid">
          <div class="skills-column">
            <h3 class="subsection-title"><span>01</span>{t.learning.skillsTitle}</h3>
            <dl class="skill-list">
              {t.learning.skills.map((skill) => (
                <div class="skill-row">
                  <dt>{skill.label}<span>{skill.level}</span></dt>
                  <dd>{skill.value}</dd>
                </div>
              ))}
            </dl>
            <p class="aws-note"><span aria-hidden="true">↳</span>{t.learning.awsNote}</p>
          </div>
          <div class="education-column">
            <h3 class="subsection-title"><span>02</span>{t.learning.educationTitle}</h3>
            <div class="education-list">
              {t.learning.education.map((item) => (
                <article class="education-item">
                  <time>{item.period}</time>
                  <div><h4>{item.title}</h4><p>{item.place}</p></div>
                </article>
              ))}
            </div>
            <div class="language-panel">
              <h3 class="subsection-title"><span>03</span>{t.learning.languagesTitle}</h3>
              {t.learning.languages.map((language) => (
                <div class="language-row"><strong>{language.name}</strong><span>{language.level}</span></div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="contact-section section-wrap" aria-labelledby="contact-heading">
        <div class="contact-content">
          <p class="section-index">{t.contact.eyebrow}</p>
          <h2 id="contact-heading">{t.contact.heading}</h2>
          <p class="contact-description">{t.contact.body}</p>
          <p class="contact-availability"><span class="status-dot" aria-hidden="true"></span>{t.contact.availability}</p>
          <div class="contact-actions">
            <a class="button button-primary contact-email" href={t.contact.emailHref}>{t.contact.emailLabel}<span aria-hidden="true">↗</span></a>
            <a href={t.contact.linkedin} target="_blank" rel="noreferrer">{t.contact.linkedinLabel}<span aria-hidden="true">↗</span></a>
            <a href={t.contact.github} target="_blank" rel="noreferrer">{t.contact.githubLabel}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <a class="contact-cv-link" href={t.contact.cvHref} download>
          {t.contact.cvLabel}<span aria-hidden="true">↓</span>
        </a>
      </section>
    </main>

    <footer class="site-footer section-wrap">
      <div class="footer-brand"><span class="footer-mark" aria-hidden="true">A.</span><span>{t.footer.signoff}</span></div>
      <p>{t.footer.build}</p>
      <a href="#top">{t.footer.top}</a>
      <small>© {new Date().getFullYear()} Arnold Chuctaya Sevincha</small>
    </footer>
  </div>
</BaseLayout>
