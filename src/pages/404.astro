---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Arnold Chuctaya"
  description="This page could not be found. Return to Arnold Chuctaya's portfolio."
  lang="en"
  canonicalPath="/404.html"
>
  <main id="main-content" class="not-found section-wrap">
    <p class="section-index">404 / NO SIGNAL</p>
    <h1>This page went off route.</h1>
    <p>The link may have moved. Let’s get you back to the main signal.</p>
    <a class="button button-primary" href="/">Back to the portfolio <span aria-hidden="true">↖</span></a>
  </main>
</BaseLayout>
